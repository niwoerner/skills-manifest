{
  "name": "@niwoerner/skills-manifest",
  "version": "0.0.10",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "skills-manifest": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niwoerner/skills-manifest.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "npm run build && node dist/index.js",
    "build": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "simple-git": "^3.36.0"
  }
}
